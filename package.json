{
  "name": "northeside",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter ./apps/* build",
    "dev": "pnpm --filter @northeside/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter ./packages/* --filter ./ops/* test",
    "test:contracts": "pnpm --filter @northeside/contracts test",
    "cli": "pnpm --filter @northeside/cli exec tsx src/index.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "tsx": "4.23.15",
    "@types/node": "22.20.5"
  }
}
