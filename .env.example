# Every variable the code reads. Production values live in Netlify (secrets: production context
# only). NEXT_PUBLIC_* values are inlined at build time: change them, then rebuild.

# ---- chain (public) ---------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=1990
CHAIN_ID=1990
NEXT_PUBLIC_MATCHWEEKS_ADDRESS=
NEXT_PUBLIC_HOST_REWARDS_ADDRESS=
NEXT_PUBLIC_IDENTITY_ADDRESS=
# QUSDC on QIE mainnet (the deploy script checks it against contracts/config/known-tokens.json).
NEXT_PUBLIC_QUSDC_ADDRESS=
# Block the contracts were deployed at; the indexer starts here (required in production).
NEXT_PUBLIC_DEPLOYED_AT_BLOCK=
NEXT_PUBLIC_SITE_URL=https://northeside.netlify.app
# An inbox you control for sponsors, privacy and security (falls back to the GitHub repo).
NEXT_PUBLIC_CONTACT_EMAIL=
# Comma-separated; defaults to the public QIE RPCs for the chain.
QIE_RPC_URLS=
NEXT_PUBLIC_QIE_RPC_URLS=
# Blocks to wait before indexing an event (reorg safety).
INDEXER_CONFIRMATIONS=6
# Optional contracts: soulbound badges (contracts/deployments/<chain>-badges.json) and the QIE ID
# .qie name registry (verified names). The CLI and jobs also accept the names without NEXT_PUBLIC_.
NEXT_PUBLIC_BADGES_ADDRESS=
NEXT_PUBLIC_QIE_ID_REGISTRY_ADDRESS=

# ---- auth ----------------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- database (Supabase: transaction pooler URL, port 6543) -----------------------
DATABASE_URL=
DATABASE_POOL_MAX=2
# 32 random bytes, base64:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Secret mixed into personHash; never rotate after launch:  openssl rand -hex 32
PERSON_PEPPER=
# Signs session cookies:  openssl rand -base64 32
SESSION_SECRET=

# ---- hot keys (server / CLI only; the admin key never goes in any env) --------------
OPERATOR_PRIVATE_KEY=
RESULTS_PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=
DRIP_PRIVATE_KEY=
# CLI only: emergency pause key (separate from the operator), sponsor key for self-funded campaigns.
PAUSER_PRIVATE_KEY=
SPONSOR_PRIVATE_KEY=
# Wei of QIEV3 per new wallet (~3 commits at 1.125 gwei) and the daily cap.
DRIP_AMOUNT_WEI=250000000000000
DRIP_DAILY_CAP_WEI=180000000000000000

# ---- identity ------------------------------------------------------------------------
# Verification provider: "qie-name" (mainnet: a .qie name owned by the wallet verifies one account) or
# "mock" (testnet/local only; refuses to run on chain 1990). Unset: verification is not offered.
QIE_PASS_MODE=

# ---- football data ---------------------------------------------------------------
FOOTBALL_DATA_API_KEY=
# Second, independent results source: "thesportsdb" (default; free public key) or "api-football"
# (needs API_FOOTBALL_KEY on a plan that covers the current season).
RESULTS_SECONDARY=thesportsdb
# Optional: a TheSportsDB Patreon key; empty uses the public free key.
THESPORTSDB_API_KEY=

# QIE ID "Get your QIE ID" widget: issued by QIE after partner approval (30% revenue share).
NEXT_PUBLIC_QIE_ID_WIDGET_ID=
NEXT_PUBLIC_QIE_ID_WIDGET_URL=

# Ask Northeside (AI assistant): Qwen on the Fortytwo network (platform.fortytwo.network).
# Off unless the key is set. Server-only: never NEXT_PUBLIC_.
FORTYTWO_API_KEY=
# Optional model override (default qwen/qwen3.8-27b) and API base (default https://api.fortytwo.network/v1).
ASSISTANT_MODEL=
FORTYTWO_BASE_URL=
# Questions per day across all players, a spend ceiling (default 2000).
ASSISTANT_GLOBAL_PER_DAY=2000
API_FOOTBALL_KEY=
# Overrides for tests/mocks only.
FOOTBALL_DATA_BASE_URL=
THESPORTSDB_BASE_URL=
API_FOOTBALL_BASE_URL=
SEASON=2026
# First matchday imported when the database is empty.
FIRST_MATCHDAY=11

# ---- weekly automation (ops-worker) -----------------------------------------------------
# A matchweek goes on-chain once its first kickoff is within this many days.
OPEN_DAYS_BEFORE_LOCK=6
# Refuse to open a matchweek that locks sooner than this (seconds).
MIN_LEAD_SECONDS=3600
# Results can be proposed this long after the last kickoff (seconds).
RESULTS_BUFFER_SECONDS=10800
# "1" stops automated transactions (needs a redeploy; prefer `pnpm cli automation pause`).
AUTOMATION_PAUSED=
# Shared secret for the cron routes and the ops-worker background function.
CRON_SECRET=
# How long one ops-worker start keeps looping, in ms (default 0 = one pass; capped at 13 minutes).
WORKER_DURATION_MS=

# ---- notifications ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Operator alerts go here; without it alerts only reach the function logs.
TELEGRAM_OPERATOR_CHAT_ID=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RESEND_API_KEY=
EMAIL_FROM=

# ---- $NSD rewards (off until launch: needs verified identity and legal review) -------------
NEXT_PUBLIC_NSD_TOKEN_ADDRESS=
NEXT_PUBLIC_NSD_REWARDS_ADDRESS=
# "1" lets the worker post weekly $NSD roots for finalized matchweeks.
NSD_REWARDS_ENABLED=
# "1" shows the claim screen and the reward wording (terms, docs, assistant). Set with the above; rebuild.
NEXT_PUBLIC_NSD_REWARDS_LIVE=
# Owner console (/owner) only: the separate pauser key and the operator key, public addresses.
NEXT_PUBLIC_PAUSER_ADDRESS=
NEXT_PUBLIC_OPERATOR_ADDRESS=
# Season 1 (docs/TOKENOMICS.md): 300,000 NSD over matchweeks 11-21. Whole tokens.
NSD_POOL_PER_MATCHWEEK=24000
NSD_SEASON_FIRST=11
NSD_SEASON_LAST=21
NSD_FINALE_POOL=36000
# Standard formula (docs/TOKENOMICS.md): top NSD_PAID_SHARE_BPS of the field (1000 = 10%), at most
# NSD_MAX_PAID places, nothing below NSD_MIN_FIELD people, no place over NSD_MAX_SHARE_BPS of a pool.
NSD_PAID_SHARE_BPS=1000
NSD_MAX_PAID=100
NSD_MIN_FIELD=10
NSD_MAX_SHARE_BPS=2000
# Optional JSON basis points per position (weekly / finale): replaces the formula with a table.
NSD_POSITIONS_BPS=
NSD_FINALE_BPS=
# DeployNSD on mainnet (1990) refuses to run unless this is exactly "deploy NSD on mainnet".
NSD_CONFIRM_MAINNET=
# DeployNSD script: total supply and the per-matchweek safety cap on NSDRewards (whole tokens).
NSD_SUPPLY=1000000
NSD_MAX_PER_MATCHWEEK=100000

# ---- observability -----------------------------------------------------------------
# Server error reports (Sentry envelope API; no SDK).
SENTRY_DSN=
# Product analytics; loads only after the visitor accepts in the cookie notice.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---- contract deploys (Foundry scripts, run from your own machine) ------------------------
# Deploy.s.sol, DeployNSD.s.sol and DeployBadges.s.sol read their own variables (DEPLOYER_PRIVATE_KEY,
# ADMIN_ADDRESS, OPERATOR_ADDRESS, PAUSER_ADDRESS, ...): see the header of each script and
# docs/DEPLOYMENT.md. Never put those keys in this file or on Netlify.

# ---- added in the 27 Nov audit ----------------------------------------------------------------
# Operator alerts by email through Resend (in addition to, or instead of, Telegram).
ALERT_EMAIL_TO=
# Old encryption keys still accepted for reading, comma separated (key rotation).
DATA_ENCRYPTION_KEY_PREVIOUS=
# Team or test wallets left out of the public traction numbers (comma separated addresses).
STATS_EXCLUDED_WALLETS=
# Local/test chains only: let web functions sign as operator/results (the e2e suite). Ignored on 1990.
WEB_SIGNERS=

# ---- contract deploy scripts (forge script) ------------------------------------------------------
DEPLOYER_PRIVATE_KEY=
ADMIN_ADDRESS=
OPERATOR_ADDRESS=
RESULTS_ADDRESS=
ATTESTER_ADDRESS=
PAUSER_ADDRESS=
TREASURY_ADDRESS=
CHALLENGER_ADDRESSES=
QUSDC_ADDRESS=
MAX_CAMPAIGN_BUDGET=
MAX_TOTAL_LIABILITY=
NSD_TREASURY_ADDRESS=
BADGES_BASE_URI=
QIE_RPC_URL=https://rpc1mainnet.qie.digital/
