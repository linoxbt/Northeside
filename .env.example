# Every variable the code reads. Production values live in Netlify (secrets: production context
# only). NEXT_PUBLIC_* values are inlined at build time: change them, then rebuild.

# ---- chain (public) ---------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=1990
CHAIN_ID=1990
NEXT_PUBLIC_MATCHWEEKS_ADDRESS=
NEXT_PUBLIC_HOST_REWARDS_ADDRESS=
NEXT_PUBLIC_IDENTITY_ADDRESS=
# QUSDC on QIE mainnet (the deploy script checks it against contracts/config/known-tokens.json).
NEXT_PUBLIC_QUSDC_ADDRESS=
# Block the contracts were deployed at; the indexer starts here (required in production).
NEXT_PUBLIC_DEPLOYED_AT_BLOCK=
NEXT_PUBLIC_SITE_URL=https://northeside.netlify.app
# An inbox you control for sponsors, privacy and security (falls back to the GitHub repo).
NEXT_PUBLIC_CONTACT_EMAIL=
# Comma-separated; defaults to the public QIE RPCs for the chain.
QIE_RPC_URLS=
NEXT_PUBLIC_QIE_RPC_URLS=
# Blocks to wait before indexing an event (reorg safety).
INDEXER_CONFIRMATIONS=6

# ---- auth ----------------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- database (Supabase: transaction pooler URL, port 6543) -----------------------
DATABASE_URL=
DATABASE_POOL_MAX=5
# 32 random bytes, base64:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Secret mixed into personHash; never rotate after launch:  openssl rand -hex 32
PERSON_PEPPER=
# Signs session cookies:  openssl rand -base64 32
SESSION_SECRET=

# ---- hot keys (server / CLI only; the admin key never goes in any env) --------------
OPERATOR_PRIVATE_KEY=
RESULTS_PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=
DRIP_PRIVATE_KEY=
# CLI only: emergency pause key (separate from the operator), sponsor key for self-funded campaigns.
PAUSER_PRIVATE_KEY=
SPONSOR_PRIVATE_KEY=
# Wei of QIEV3 per new wallet (~3 commits at 1.125 gwei) and the daily cap.
DRIP_AMOUNT_WEI=250000000000000
DRIP_DAILY_CAP_WEI=180000000000000000

# ---- identity ------------------------------------------------------------------------
# Unset on mainnet until a real QIE Pass provider exists ("mock" works on testnet/local only).
QIE_PASS_MODE=

# ---- football data ---------------------------------------------------------------
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=
# Overrides for tests/mocks only.
FOOTBALL_DATA_BASE_URL=
API_FOOTBALL_BASE_URL=
SEASON=2026
# First matchday imported when the database is empty.
FIRST_MATCHDAY=11

# ---- weekly automation (ops-worker) -----------------------------------------------------
# A matchweek goes on-chain once its first kickoff is within this many days.
OPEN_DAYS_BEFORE_LOCK=6
# Refuse to open a matchweek that locks sooner than this (seconds).
MIN_LEAD_SECONDS=3600
# Results can be proposed this long after the last kickoff (seconds).
RESULTS_BUFFER_SECONDS=10800
# "1" stops automated transactions (needs a redeploy; prefer `pnpm cli automation pause`).
AUTOMATION_PAUSED=
# Shared secret for the cron routes and the ops-worker background function.
CRON_SECRET=

# ---- notifications ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Operator alerts go here; without it alerts only reach the function logs.
TELEGRAM_OPERATOR_CHAT_ID=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RESEND_API_KEY=
EMAIL_FROM=

# ---- observability -----------------------------------------------------------------
# Server error reports (Sentry envelope API; no SDK).
SENTRY_DSN=
# Product analytics; loads only after the visitor accepts in the cookie notice.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
