# ---- chain (public) ---------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=1990
NEXT_PUBLIC_MATCHWEEKS_ADDRESS=
NEXT_PUBLIC_HOST_REWARDS_ADDRESS=
NEXT_PUBLIC_IDENTITY_ADDRESS=
# QUSDC on QIE mainnet. Verified on-chain 2026-11-12: symbol QUSDC, 6 decimals.
NEXT_PUBLIC_QUSDC_ADDRESS=0x3F43DA82eC9A4f5285F10FaF1F26EcA7319E5DA5
NEXT_PUBLIC_DEPLOYED_AT_BLOCK=
NEXT_PUBLIC_SITE_URL=https://northeside.app
# Comma-separated; defaults to the five public QIE mainnet RPCs.
QIE_RPC_URLS=

# ---- auth ----------------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- database (Supabase: use the transaction pooler URL, port 6543) -----------------
DATABASE_URL=
# 32 random bytes, base64:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Secret mixed into personHash; never rotate after launch:  openssl rand -hex 32
PERSON_PEPPER=
# Signs session cookies:  openssl rand -base64 32
SESSION_SECRET=

# ---- hot keys (server / CLI only; the admin key never goes in any env) --------------
OPERATOR_PRIVATE_KEY=
RESULTS_PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=
DRIP_PRIVATE_KEY=
# ~3x the cost of one commit, in wei of QIEV3. Measure on mainnet before launch.
DRIP_AMOUNT_WEI=
DRIP_DAILY_CAP_WEI=

# ---- football data ---------------------------------------------------------------
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=
SEASON=2026

# ---- notifications ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OPERATOR_CHAT_ID=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RESEND_API_KEY=
EMAIL_FROM=Northeside <hello@northeside.app>

# ---- observability -----------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---- cron ----------------------------------------------------------------------------
CRON_SECRET=
